#! Noncanonical full-rank invariance and mixed-rank Brueckner references.
#! BH/6-31G with a frozen B 1s has four correlated electrons, so untruncated
#! CCSDTQ must be independent of active occupied/virtual rotations up to DF error.

import numpy as np
from pathlib import Path
import re

memory 2 GB

molecule bh {
0 1
B
H 1 1.232
symmetry c1
}

set {
    basis 6-31g
    reference rhf
    freeze_core true
    scf_type df
    # SCF/orbital updates use a JK-fit basis; correlation uses an RI basis.
    # Oversized, distinct fits suppress the remaining DF contribution to
    # the orbital-invariance comparison without equating the auxiliaries.
    df_basis_scf cc-pv5z-jkfit
    df_basis_cc cc-pv5z-ri
    e_convergence 1.0e-11
    d_convergence 1.0e-11
    r_convergence 1.0e-10
    brueckner_orbs_r_convergence 1.0e-8
    brueckner_maxiter 80
    dlpno_maxiter 100
    dlpno_toggle_memory false
    t_cut_pno 0.0
    t_cut_pno_mp2 0.0
    t_cut_pairs 0.0
    t_cut_pairs_mp2 0.0
    t_cut_pre 0.0
    t_cut_do 0.0
    t_cut_do_pre 0.0
    t_cut_do_ij 0.0
    t_cut_do_uv 0.0
    t_cut_mkn 0.0
    t_cut_clmo 0.0
    t_cut_cpao 0.0
    f_cut 0.0
    dlpno_ao_ints_tol 1.0e-14
    t_cut_tno 0.0
    t_cut_tno_pre 0.0
    t_cut_tno_full 0.0
    t_cut_triples_weak 0.0
    t_cut_do_triples 0.0
    t_cut_do_triples_pre 0.0
    t_cut_mkn_triples 0.0
    t_cut_mkn_triples_pre 0.0
    f_cut_t 0.0
    t_cut_iter 0.0
    t_cut_qno 0.0
    t_cut_qno_pre 0.0
    t_cut_qno_full 0.0
    t_cut_quads_weak 0.0
    t_cut_do_quads 0.0
    t_cut_do_quads_pre 0.0
    t_cut_mkn_quads 0.0
    t_cut_mkn_quads_pre 0.0
    f_cut_q 0.0
    t_cut_iter_q 0.0
    t_cut_xpno 0.0
}

set_num_threads(1)
escf, ref = energy('scf', return_wfn=True)
C_initial = ref.Ca().np.copy()
reference_energy = energy('dlpno-ccsdtq', ref_wfn=ref)
clean()

def check_execution_order(output, rank, final_quadruples=True):
    before, after = output.split('Brueckner orbital optimization converged', 1)
    # Match solver headers, not the driver banner or repeated energy summaries.
    header = r'^\s+(DLPNO-(?:BCCD\(T\)|CCSD\(T\)|CCSDT(?:\(Q\)|Q)?))\s*$'
    initial_stages = re.findall(header, before, re.MULTILINE)
    final_stages = re.findall(header, after, re.MULTILINE)
    stage_ranks = {'DLPNO-BCCD(T)': 3, 'DLPNO-CCSD(T)': 3,
                   'DLPNO-CCSDT': 3, 'DLPNO-CCSDT(Q)': 4, 'DLPNO-CCSDTQ': 4}
    compare_integers(1, int(all(stage_ranks[s] <= rank for s in initial_stages)),
                     'orbital iterations stop at selected reference rank')  #TEST
    expected = []
    if rank == 2:
        expected += ['DLPNO-BCCD(T)', 'DLPNO-CCSDT']
    if rank < 4:
        expected += ['DLPNO-CCSDT(Q)']
        if final_quadruples:
            expected += ['DLPNO-CCSDTQ']
    compare_integers(1, int(final_stages == expected),
                     'remaining stages run once in order after orbital convergence')  #TEST

for orbitals, method, rank in [('BCCD', 'dlpno-ccsdtq', 2),
                                ('BCCDT', 'dlpno-ccsdtq', 3),
                                ('HF', 'dlpno-bccdtq', 4)]:
    set_options({'dlpno_reference_orbitals': orbitals})
    core.flush_outfile()
    output_start = len(Path(core.get_output_file()).read_text())
    result, wfn = energy(method, ref_wfn=ref, return_wfn=True)
    core.flush_outfile()
    check_execution_order(Path(core.get_output_file()).read_text()[output_start:], rank)
    for label, stage_rank in [('CCSD(T)', 3), ('CCSDT', 3), ('CCSDT(Q)', 4), ('CCSDTQ', 4)]:
        compare_integers(int(stage_rank <= rank),
                         int(wfn.has_variable('INITIAL DLPNO-' + label + ' TOTAL ENERGY')),
                         label + ': initial energy only when required for orbital optimization')  #TEST
    compare_values(reference_energy, result, 1.0e-7,
                   method + ' on ' + orbitals + ': four-electron invariance')  #TEST
    compare_values(result, variable('CCSDTQ TOTAL ENERGY'), 10, 'final-rank energy')  #TEST
    compare_integers(rank, int(variable('BRUECKNER REFERENCE RANK')), 'optimized rank')  #TEST
    compare_integers(1, int(variable('BRUECKNER ITERATIONS') > 0),
                     'orbital updates rebuild the pair maps')  #TEST
    compare_integers(1, int(variable('BRUECKNER ORBITAL RESIDUAL MAX') < 1.0e-8),
                     'converged singles at orbital-reference rank')  #TEST
    compare_values(escf, variable('SCF TOTAL ENERGY'), 11, 'input SCF provenance')  #TEST
    compare_values(result, variable('CURRENT REFERENCE ENERGY') +
                   variable('CURRENT CORRELATION ENERGY'), 11, 'energy decomposition')  #TEST
    C = wfn.Ca().np
    compare_arrays(np.eye(C.shape[1]), C.T @ wfn.S().np @ C, 1.0e-10,
                   'orthogonal optimized orbitals')  #TEST
    compare_arrays(C_initial, ref.Ca().np, 1.0e-12, 'input orbitals unchanged')  #TEST
    clean()

# BCCDT(Q) must mean (Q) after a full-triples orbital optimization.
set dlpno_reference_orbitals HF
core.flush_outfile()
output_start = len(Path(core.get_output_file()).read_text())
eq_alias = energy('dlpno-bccdt(q)', ref_wfn=ref)
core.flush_outfile()
check_execution_order(Path(core.get_output_file()).read_text()[output_start:], 3, final_quadruples=False)
compare_values(eq_alias, variable('BCCDT(Q) TOTAL ENERGY'), 10, 'BCCDT(Q) result variable')  #TEST
compare_integers(3, int(variable('BRUECKNER REFERENCE RANK')), 'BCCDT(Q) reference rank')  #TEST
clean()

set dlpno_reference_orbitals BCCDT
eq_explicit = energy('dlpno-ccsdt(q)', ref_wfn=ref)
compare_values(eq_alias, eq_explicit, 1.0e-10, 'BCCDT(Q) alias versus explicit reference')  #TEST
clean()
