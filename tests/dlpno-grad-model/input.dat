#! Test the explicit RI gradient terms and ordinary (T)-sourced RHF Lambda equations.
#! The references are fixed-geometry canonical DF-CCSD(T) derivatives with
#! only the specified fitting integral varied. See canonical_reference.py.

import numpy as np
from psi4.driver.p4util.exceptions import ValidationError

memory 1 GB
molecule h2o {
0 1
O
H 1 0.958
H 1 0.958 2 104.4776
symmetry c1
}

set {
    basis cc-pvdz
    reference rhf
    freeze_core true
    scf_type df
    cc_type df
    df_basis_scf cc-pvdz-jkfit
    df_basis_cc cc-pvdz-ri
    e_convergence 1.0e-11
    r_convergence 1.0e-10
    d_convergence 1.0e-11
    dlpno_maxiter 120
    dlpno_ao_ints_tol 1.0e-14
    t_cut_pno 0
    t_cut_pno_mp2 0
    t_cut_do 0
    t_cut_do_pre 0
    t_cut_do_ij 0
    t_cut_do_uv 0
    t_cut_mkn 0
    t_cut_pairs 0
    t_cut_pairs_mp2 0
    t_cut_pre 0
    t_cut_clmo 0
    t_cut_cpao 0
    f_cut 0
    t_cut_tno 0
    t_cut_do_triples 0
    t_cut_mkn_triples 0
    f_cut_t 0
    dlpno_gradient_model true
}
set dlpno debug 1

metric_key = 'DLPNO (T) AUXILIARY METRIC GRADIENT'
three_key = 'DLPNO (T) THREE-CENTER GRADIENT'
# Values obtained by symmetric matrix perturbations of 1.e-5 bohr.
metric_ref = np.array([[0., 0., 0.00043616262],
                       [0., 0.00017544919, -0.00021808131],
                       [0., -0.00017544919, -0.00021808131]])
three_ref = np.array([[0., 0., 0.00190046913],
                      [0., 0.00114142153, -0.00095023456],
                      [0., -0.00114142153, -0.00095023456]])

def check_truncation(w):
    parts = [w.variable('DLPNO ' + which + ' PNO TRUNCATION ENERGY') for which in ('INITIAL', 'FINAL')]
    compare_values(w.variable('DLPNO PNO TRUNCATION ERROR'), sum(parts), 1.e-9,
                   'two reconstructed corrections match the forward energy')                                  #TEST
    for which in ('INITIAL', 'FINAL'):
        for probe in ('DIRECTION ERROR', 'SINGLES DIRECTION ERROR'):
            compare_values(0., w.variable(f'DLPNO {which} PNO TRUNCATION {probe}'), 1.e-7,
                           f'{which} truncation correction {probe}')                                           #TEST
    compare_values(0., w.variable('DLPNO PNO TRUNCATION DF DIRECTION ERROR'), 1.e-7,
                   'nested first and final correction using perturbed primitive fitting integrals')             #TEST

def check_lmp2(w):
    for key, tol in [('ADJOINT RESIDUAL', 1.e-10), ('SAVED RIGHT RESIDUAL', 1.e-10),
                     ('TRANSPOSE DOT ERROR', 1.e-10), ('TANGENT DIRECTION ERROR', 1.e-8)]:
        compare_values(0., w.variable('DLPNO LMP2 ' + key), tol, 'first-space LMP2 ' + key)                    #TEST

def check_local_spaces(w):
    for label in ('ACTIVE', 'FROZEN', 'FOCK', 'OVERLAP'):
        compare_values(0., w.variable(f'DLPNO {label} PROJECTOR DIRECTION ERROR'), 1.e-8,
                       f'{label} orbital response from occupied projection')                                  #TEST
    for label in ('PNO COEFFICIENT', 'FOCK', 'PAO OVERLAP'):
        compare_values(0., w.variable(f'DLPNO (T) {label} DIRECTION ERROR'), 1.e-8,
                       f'iterative triples local {label} derivative')                                          #TEST
    for label in ('INITIAL', 'FINAL'):
        compare_values(0., w.variable(f'DLPNO (T) {label} PNO PROJECTOR DIRECTION ERROR'), 1.e-7,
                       f'ordinary triples {label} PNO projector')                                              #TEST
    for label in ('PNO PROJECTOR OPERATOR', 'PARENT PAO METRIC', 'DF ORBITAL COEFFICIENT', 'DF LMO REFIT', 'PAO NORMALIZATION'):
        compare_values(0., w.variable(f'DLPNO {label} DIRECTION ERROR'), 1.e-7, label)                          #TEST
    compare_values(0., w.variable('DLPNO DF ORBITAL REPLAY ERROR'), 1.e-10,
                   'reconstructed screened fit matches the forward three-center integrals')                    #TEST

# The inverse-square-root kernel is shared by the CCSD Lambda and Hessian paths.
# Rotate a filtered metric while varying both repeated positive eigenvalues.
ev = np.diag([0., 4., 4.])
rot = np.array([[0., .3, -.1], [-.3, 0., .2], [.1, -.2, 0.]])
slope = np.diag([0., .4, -.2])
direction = rot @ ev - ev @ rot + slope
root, droot = psi4.core.dlpno_pair_metric_tangent(psi4.core.Matrix.from_array(ev),
                                                   psi4.core.Matrix.from_array(direction))
expected = rot @ root.np - root.np @ rot - slope / 16.
compare_arrays(expected, droot.np, 1.e-12, 'rank-filtered repeated metric eigenvalues')                      #TEST

def check_stationarity(w):
    for block in ('R1 TANGENT', 'R2 TANGENT', 'TANGENT DUALITY'):
        compare_values(0., w.variable('DLPNO CCSD FOCK ' + block + ' ERROR'), 1.e-8,
                       'CCSD projected Fock source ' + block)                                                 #TEST
    check_local_spaces(w)
    check_lmp2(w)
    check_truncation(w)
    compare_values(0., w.variable('DLPNO (T) TRANSPOSE DOT ERROR'), 1.e-12, 'packed B transpose')            #TEST
    compare_values(0., w.variable('DLPNO (T) RIGHT RESIDUAL'), 1.e-10, 'T3 residual')                         #TEST
    compare_values(0., w.variable('DLPNO (T) ADJOINT RESIDUAL'), 1.e-10, 'Z3 residual')                      #TEST
    compare_values(w.variable('(T) CORRECTION ENERGY'), w.variable('DLPNO (T) ADJOINT ENERGY'),
                   1.e-9, 'right and left triples energy')                                                     #TEST
    compare_values(-2*w.variable('(T) CORRECTION ENERGY'),
                   w.variable('DLPNO (T) AUXILIARY METRIC SCALE DERIVATIVE'),
                   1.e-8, 'RHF (T) derivative under uniform metric scaling')                                    #TEST
    compare_values(0., w.variable('DLPNO CCSD INITIAL PNO PROJECTOR DIRECTION ERROR'), 1.e-7,
                   'first PNO projector through semicanonical exchange and energies')                          #TEST
    compare_values(0., w.variable('DLPNO CCSD FINAL PNO PROJECTOR DIRECTION ERROR'), 1.e-7,
                   'final PNO projector derivative through LMP2 amplitudes')                                   #TEST
    for group in ('INTEGRAL', 'FOCK', 'OVERLAP', 'PNO COEFFICIENT'):
        compare_values(0., w.variable(f'DLPNO CCSD {group} DIRECTION ERROR'), 1.e-8,
                       f'stationary CCSD derivative with respect to {group}')                                  #TEST
    for rank in (1, 2):
        compare_values(0., w.variable(f'DLPNO CCSD(T) LAMBDA{rank} RESIDUAL'), 1.e-10,
                       f'converged sourced Lambda{rank}')                                                      #TEST
        compare_values(0., w.variable(f'DLPNO CCSD L{rank} DIRECTION ERROR'), 1.e-8,
                       f'CCSD rank {rank} transpose against right residual')                                   #TEST
        compare_values(0., w.variable(f'DLPNO (T) L{rank} SOURCE DIRECTION ERROR'), 1.e-8,
                       f'ordinary (T) rank {rank} source with responding TNOs')                                #TEST
    compare_values(0., w.variable('DLPNO (T) L2 TNO DIRECTION ERROR'), 1.e-8,
                   'kept/discarded TNO contribution to Lambda2')                                               #TEST
    compare_values(2*w.variable('(T) CORRECTION ENERGY'),
                   w.variable('DLPNO (T) T1 SCALE DERIVATIVE') + w.variable('DLPNO (T) T2 SCALE DERIVATIVE'),
                   1.e-9, 'homogeneous triples energy under joint amplitude scaling')                          #TEST
    assert not w.has_variable('CURRENT GRADIENT')

e_df = energy('ccsd(t)')
for loc in ('BOYS', 'PIPEK_MEZEY', 'IBO'):
    psi4.set_options({'dlpno_local_orbitals': loc})
    e, w = energy('dlpno-ccsd(t)', return_wfn=True)
    compare_values(e_df, e, 1.e-7, loc + ' zero-cutoff DF-CCSD(T) energy')                                               #TEST
    compare_values(-0.00304081137850, w.variable('(T) CORRECTION ENERGY'), 1.e-9, loc + ' canonical (T)')       #TEST
    check_stationarity(w)
    # Phase-independent rotation of the frozen O 1s toward a virtual direction.
    ref = w.reference_wavefunction()
    Cv = ref.Ca_subset('AO','VIR').np
    Cf = ref.Ca_subset('AO','FROZEN_OCC').np
    v = ref.S().np @ (np.sin(.37*np.arange(1,Cv.shape[0]+1))/np.sqrt(Cv.shape[0]))
    rhs = psi4.core.Matrix.from_array((Cf.T @ v)[:,None])
    frozen_bar = psi4.core.dlpno_orbital_response_action(w,'FROZEN',rhs)
    compare_values(1., w.variable('DLPNO PROJECTOR FROZEN ORBITALS'), 1.e-12, 'one frozen O 1s')              #TEST
    compare_values(-3.018030e-5, (Cv @ (Cv.T @ v)) @ frozen_bar.np[:,0], 1.e-9,
                   loc + ' canonical frozen-core/virtual rotation')                                           #TEST
    for label, reference in [('OCCUPIED', -0.00145663518474), ('VIRTUAL', 0.00145663518476)]:
        compare_values(reference, w.variable(f'DLPNO (T) {label} FOCK SHIFT DERIVATIVE'), 1.e-9,
                       loc + ' canonical triples Fock shift ' + label)                                         #TEST
    compare_values(0., w.variable('DLPNO LMP2 ADJOINT NORM'), 1.e-12, loc + ' full-rank LMP2 source')         #TEST
    for label in ('AUXILIARY METRIC', 'THREE-CENTER'):
        compare_arrays(np.zeros((3, 3)), w.variable('DLPNO PNO PROJECTOR ' + label + ' GRADIENT').np,
                       1.e-12, loc + ' full-rank PNO projector derivative')                                    #TEST
        compare_arrays(np.zeros((3, 3)), w.variable('DLPNO LMP2 RESPONSE ' + label + ' GRADIENT').np,
                       1.e-12, loc + ' full-rank LMP2 relaxation')                                             #TEST
        compare_arrays(np.zeros((3, 3)), w.variable('DLPNO PNO TRUNCATION ' + label + ' GRADIENT').np,
                       1.e-12, loc + ' full-rank truncation correction derivative')                            #TEST
    for key, ref in [('DLPNO (T) T1 SCALE DERIVATIVE', 0.00008531657979),
                     ('DLPNO (T) T2 SCALE DERIVATIVE', -0.00616693933676),
                     ('DLPNO CCSD(T) LAMBDA1 T1 CONTRACTION', 0.00044402383150),
                     ('DLPNO CCSD(T) LAMBDA2 T2 CONTRACTION', 0.05763646059833)]:
        compare_values(ref, w.variable(key), 1.e-9, loc + ' canonical ' + key)                                 #TEST
    compare_arrays(metric_ref, w.variable(metric_key).np, 1.e-8, loc + ' RI metric derivative')                #TEST
    compare_arrays(three_ref, w.variable(three_key).np, 1.e-8, loc + ' RI three-center derivative')            #TEST

    ccsd_metric = np.array([[0., 0., -0.0235532256], [0., -0.0153418357, 0.0117766128],
                            [0., 0.0153418357, 0.0117766128]])
    ccsd_three = np.array([[0., 0., 0.0627802928], [0., 0.0351161237, -0.0313901464],
                           [0., -0.0351161237, -0.0313901464]])
    for label, ref in [('AUXILIARY METRIC', ccsd_metric), ('THREE-CENTER', ccsd_three)]:
        compare_arrays(ref, w.variable('DLPNO CCSD ' + label + ' GRADIENT').np, 1.e-8,
                       loc + ' canonical CCSD ' + label)                                                       #TEST

# Different TNO ranks exercise rectangular projections and the transpose scatter.
# Compare the disk generations at four threads with the serial in-memory solution.
set t_cut_pno_mp2 1.e-6
set t_cut_pno 1.e-5
set t_cut_tno 1.e-5
set min_tnos 3
set dlpno_local_orbitals boys
psi4.set_num_threads(1)
e, w = energy('dlpno-ccsd(t)', return_wfn=True)
check_stationarity(w)
assert w.variable("DLPNO CCSD INITIAL PNO SPLITS") > 0
assert w.variable("DLPNO CCSD FINAL PNO SPLITS") > 0
mem_metric = w.variable(metric_key).np.copy()
mem_three = w.variable(three_key).np.copy()
lambda_keys = ['DLPNO CCSD(T) LAMBDA1 T1 CONTRACTION', 'DLPNO CCSD(T) LAMBDA2 T2 CONTRACTION']
mem_lambda = [w.variable(key) for key in lambda_keys]
cc_keys = ['DLPNO CCSD ' + label + ' GRADIENT' for label in ('AUXILIARY METRIC', 'THREE-CENTER')]
cc_keys.extend(['DLPNO PNO TRUNCATION ' + label + ' GRADIENT' for label in ('AUXILIARY METRIC', 'THREE-CENTER')])
cc_keys.extend(['DLPNO PNO PROJECTOR ' + label + ' GRADIENT' for label in ('AUXILIARY METRIC', 'THREE-CENTER')])
cc_keys.extend(['DLPNO LMP2 RESPONSE ' + label + ' GRADIENT' for label in ('AUXILIARY METRIC', 'THREE-CENTER')])
assert w.variable('DLPNO LMP2 RECTANGULAR RESPONSE EDGES') > 0
assert abs(w.variable('DLPNO LMP2 RELAXED DIRECTION')) > 1.e-8
assert w.variable('DLPNO LMP2 ADJOINT NORM') > 1.e-5
mem_cc = [w.variable(key).np.copy() for key in cc_keys]
assert all(abs(w.variable(f'DLPNO {stage} PNO TRUNCATION ENERGY')) > 1.e-7 for stage in ('INITIAL', 'FINAL'))
assert all(np.max(np.abs(x)) > 1.e-8 for x in mem_cc[-6:])
assert abs(w.variable('DLPNO (T) L2 TNO SOURCE DIRECTION')) > 1.e-8
assert abs(e - e_df) > 1.e-6
set write_qia_pno true
set write_qab_pno true
set low_memory_overlap true
set write_triples_amplitudes true
set write_triples_intermediates true
psi4.set_num_threads(4)
edisk, wdisk = energy('dlpno-ccsd(t)', return_wfn=True)
check_stationarity(wdisk)
for key, ref in zip(lambda_keys, mem_lambda):
    compare_values(ref, wdisk.variable(key), 1.e-9, 'disk and semi-direct ' + key)                              #TEST
compare_values(e, edisk, 1.e-9, 'single-space disk energy')                                                   #TEST
compare_arrays(mem_metric, wdisk.variable(metric_key).np, 1.e-9, 'single-space disk metric gradient')           #TEST
compare_arrays(mem_three, wdisk.variable(three_key).np, 1.e-9, 'single-space disk three-center gradient')       #TEST
for key, ref in zip(cc_keys, mem_cc):
    compare_arrays(ref, wdisk.variable(key).np, 1.e-9, 'disk and semi-direct ' + key)                         #TEST
for term in (mem_metric, mem_three, *mem_cc):
    compare_arrays(np.zeros(3), term.sum(axis=0), 1.e-9, 'translation invariance of each RI term')              #TEST

# With all occupied Fock couplings screened, each pair is diagonal in
# the first semicanonical PNO basis and the preconditioner solves it exactly.
set f_cut 10
_, uncoupled = energy('dlpno-ccsd(t)', return_wfn=True)
check_lmp2(uncoupled)
compare_values(0, uncoupled.variable('DLPNO LMP2 RESPONSE EDGES'), 1.e-12, 'uncoupled LMP2 graph')            #TEST
compare_values(1, uncoupled.variable('DLPNO LMP2 ADJOINT ITERATIONS'), 1.e-12, 'diagonal adjoint solve')      #TEST
set f_cut 0

# Match the ordinary right-hand solver with both T0 and iterative (T) in
# the same truncated space, all pairs strong and triplet energy screening off.
psi4.set_num_threads(1)
psi4.set_options({'dlpno_gradient_model': False, 't_cut_triples_weak': 0., 't_cut_iter': 0.,
                  't_cut_tno_strong': 1.e-5, 't_cut_tno_weak': 1.e-5,
                  'write_triples_amplitudes': False, 'write_triples_intermediates': False,
                  'write_qia_pno': False, 'write_qab_pno': False, 'low_memory_overlap': False})
production = energy('dlpno-ccsd(t)')
compare_values(production, e, 1.e-8, 'finite-cutoff original right solver in matching spaces')                #TEST
set dlpno_gradient_model true

# The default plan is analytic even when the standalone energy model is off.
set dlpno_gradient_model false
assert gradient('dlpno-ccsd(t)', return_plan=True).driver == 'gradient'
try:
    gradient('dlpno-ccsd(t)', dertype=0, return_plan=True)
except ValidationError as exc:
    assert 'must be analytic' in str(exc)
else:
    raise AssertionError('DLPNO-CCSD(T) must reject finite-difference gradients')
set dlpno_gradient_model true

# A one-occupied-orbital reference has no triples blocks.
molecule h2 {
H
H 1 0.74
symmetry c1
}
_, empty = energy('dlpno-ccsd(t)', return_wfn=True)
check_stationarity(empty)
compare_values(0., empty.variable('DLPNO PROJECTOR FROZEN ORBITALS'), 1.e-12, 'empty frozen subspace')       #TEST
zero_core = psi4.core.dlpno_orbital_response_action(empty, 'FROZEN', psi4.core.Matrix(0,2))
compare_arrays(np.zeros((empty.basisset().nbf(),2)), zero_core.np, 1.e-14, 'empty frozen source action')     #TEST
compare_values(0., empty.variable('(T) CORRECTION ENERGY'), 1.e-14, 'empty triples energy')                    #TEST
for key in (metric_key, three_key):
    compare_arrays(np.zeros((2, 3)), empty.variable(key).np, 1.e-14, 'empty triples derivative')               #TEST

# An explicitly selected energy model must reject other triples functionals.
for name in ('dlpno-ccsd(t0)', 'dlpno-ccsd(t)_l', 'dlpno-bccd(t)'):
    try:
        energy(name)
    except RuntimeError as exc:
        assert 'DLPNO_GRADIENT_MODEL requires closed-shell RHF DLPNO-CCSD(T)' in str(exc)
    else:
        raise AssertionError('Unexpected acceptance of ' + name)

# The screened graph of this interacting chain has retained ik and ij edges
# for which kj is absent. R2 still depends on that bare occupied Fock element.
molecule chain {
0 1
H 0   0 -.37
H 0   0  .37
H 3.5 0 -.37
H 3.5 0  .37
H 7   0 -.37
H 7   0  .37
H 10.5 0 -.37
H 10.5 0  .37
units angstrom
symmetry c1
no_com
no_reorient
}
set t_cut_pairs_mp2 1.e-6
set low_memory_overlap true
_, chain_wfn = energy('dlpno-ccsd(t)', return_wfn=True)
check_truncation(chain_wfn)
check_lmp2(chain_wfn)
check_local_spaces(chain_wfn)
compare_values(10., chain_wfn.variable('DLPNO CCSD RESPONSE ORDERED PAIRS'), 1.e-12,
               'screened H2 chain includes nearest-neighbor pairs')                                            #TEST
for group in ('INTEGRAL', 'FOCK', 'OVERLAP', 'PNO COEFFICIENT'):
    compare_values(0., chain_wfn.variable(f'DLPNO CCSD {group} DIRECTION ERROR'), 1.e-8,
                   'screened chain ' + group)                                                                  #TEST
